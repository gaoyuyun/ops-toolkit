#!/usr/bin/env bash
set -Eeuo pipefail

readonly VERSION='@VERSION@'
readonly RELEASE_BASE_URL='@RELEASE_BASE_URL@'
readonly ARCHIVE="ops-toolkit-v${VERSION}.tar.gz"
readonly PACKAGE="ops-toolkit-v${VERSION}"

prefix=${OPS_INSTALL_PREFIX:-/opt/ops-toolkit}
bin_dir=${OPS_INSTALL_BIN_DIR:-/usr/local/bin}
temp_dir=''

usage() {
  cat <<EOF
Usage: install.sh [--prefix DIR] [--bin-dir DIR]

Install or upgrade ops-toolkit $VERSION. Existing version directories are kept
for rollback. Defaults:
  --prefix  /opt/ops-toolkit
  --bin-dir /usr/local/bin

Run this script as root when using the default system paths.
EOF
}

cleanup() {
  [[ -z $temp_dir ]] || rm -rf -- "$temp_dir"
}
trap cleanup EXIT INT TERM

die() {
  printf 'ops-toolkit installer: %s\n' "$*" >&2
  exit 1
}

validate_absolute_path() {
  [[ $1 == /* && $1 != *$'\n'* && $1 != *'/../'* && $1 != */.. && $1 != *'/./'* ]]
}

download() {
  local url=$1 destination=$2
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --retry 3 --connect-timeout 10 --output "$destination" "$url"
  elif command -v wget >/dev/null 2>&1; then
    wget -q --https-only --tries=3 --timeout=10 --output-document="$destination" "$url"
  else
    die 'curl or wget is required.'
  fi
}

while (($#)); do
  case $1 in
    --prefix)
      (($# >= 2)) || die '--prefix requires a directory.'
      prefix=$2
      shift 2
      ;;
    --bin-dir)
      (($# >= 2)) || die '--bin-dir requires a directory.'
      bin_dir=$2
      shift 2
      ;;
    --help | -h)
      usage
      exit 0
      ;;
    *) die "unknown option: $1" ;;
  esac
done

validate_absolute_path "$prefix" || die 'install prefix must be an absolute path without parent traversal.'
validate_absolute_path "$bin_dir" || die 'bin directory must be an absolute path without parent traversal.'
command -v tar >/dev/null 2>&1 || die 'tar is required.'
command -v install >/dev/null 2>&1 || die 'install is required.'

if ((EUID != 0)) && { [[ $prefix == /opt/* || $prefix == /usr/* ]] || [[ $bin_dir == /usr/* ]]; }; then
  die 'default system paths require root; rerun with sudo or choose writable --prefix and --bin-dir paths.'
fi

printf 'Installing ops-toolkit %s — %s / %s\n' "$VERSION" "$(uname -s)" "$(uname -m)" >&2
temp_dir=$(mktemp -d "${TMPDIR:-/tmp}/ops-toolkit-install.XXXXXXXX")
download "$RELEASE_BASE_URL/$ARCHIVE" "$temp_dir/$ARCHIVE"
download "$RELEASE_BASE_URL/$ARCHIVE.sha256" "$temp_dir/$ARCHIVE.sha256"

expected=$(awk 'NR == 1 {print $1}' "$temp_dir/$ARCHIVE.sha256")
[[ $expected =~ ^[0-9a-fA-F]{64}$ ]] || die 'invalid checksum file.'
if command -v sha256sum >/dev/null 2>&1; then
  actual=$(sha256sum "$temp_dir/$ARCHIVE" | awk '{print $1}')
elif command -v shasum >/dev/null 2>&1; then
  actual=$(shasum -a 256 "$temp_dir/$ARCHIVE" | awk '{print $1}')
else
  die 'sha256sum or shasum is required.'
fi
[[ $actual == "$expected" ]] || die 'archive checksum mismatch.'

tar -xzf "$temp_dir/$ARCHIVE" -C "$temp_dir"
source_dir=$temp_dir/$PACKAGE
[[ -x $source_dir/bin/opsctl ]] || die 'release entry point is missing.'

install -d -m 0755 "$prefix" "$bin_dir"
destination=$prefix/$PACKAGE
staged=$prefix/.$PACKAGE.install.$$
current=$prefix/current
launcher=$bin_dir/opsctl

[[ ! -e $staged && ! -L $staged ]] || die "temporary install path already exists: $staged"
[[ ! -L $destination ]] || die "refusing to replace symlinked version directory: $destination"
[[ ! -e $destination || -d $destination ]] || die "version destination is not a directory: $destination"
[[ ! -e $current || -L $current ]] || die "refusing to replace non-symlink current path: $current"
[[ ! -e $launcher || -L $launcher ]] || die "refusing to replace non-symlink launcher: $launcher"

cp -a "$source_dir" "$staged"
if [[ -d $destination ]]; then
  rm -rf -- "$destination"
fi
mv -- "$staged" "$destination"
rm -f -- "$current" "$launcher"
ln -s "$destination" "$current"
ln -s "$current/bin/opsctl" "$launcher"

printf 'Installed ops-toolkit %s at %s\n' "$VERSION" "$destination"
printf 'Launcher: %s -> %s\n' "$launcher" "$current/bin/opsctl"
"$launcher" --version
