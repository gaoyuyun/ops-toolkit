# Copy to /etc/ops-toolkit/config.env or ~/.config/ops-toolkit/config.env.
# Keep host-specific values out of Git.
#
# Docker Fleet host layout (all values below follow it):
#   /srv/docker/data    stack bind data (OPS_DATA_ROOT)
#   /srv/docker/fleet   releases/, current/, previous/, state/deployment.json
#   /srv/docker/env     per-stack environment files
#   /srv/docker/backup  Fleet-managed stack backups
OPS_DATA_ROOT=/srv/docker/data
OPS_DOCKER_GROUP=docker-data
OPS_DEFAULT_SSH_PORT=22
OPS_XRAY_CONTAINER=xray
OPS_NGINX_CONTAINER=nginx
# Fleet xray stack: ${DATA_ROOT}/xray/config.json (uid 65532, 2750/0640).
OPS_XRAY_CONFIG=/srv/docker/data/xray/config.json
# Standalone hosts only; Fleet renders default.stream inside the edge release.
OPS_NGINX_STREAM_CONFIG=/srv/docker/data/nginx/conf.d/default.stream
# Reality scan artifacts. Keep this outside the Fleet-owned xray directory.
OPS_XRAY_LOG_DIR=/srv/docker/data/ops-toolkit/xray
# Docker Fleet deployment marker used to switch Xray into read-only management mode.
OPS_FLEET_STATE_FILE=/srv/docker/fleet/state/deployment.json
# Optional overrides. Defaults: ~/.local/bin for users, /usr/local/bin for root.
# OPS_BIN_DIR=/usr/local/bin
# OPS_XRAY_BIN=/usr/local/bin/xray
# OPS_SING_BOX_BIN=/usr/local/bin/sing-box
# OPS_XRAY_SCANNER=/usr/local/bin/RealiTLScanner
# OPS_XRAY_CHECKER=/usr/local/bin/reality-checker
OPS_NGINX_LOG_PATH=/var/log/nginx/*.log
OPS_VAULTWARDEN_LOG_PATH=/var/log/vaultwarden/*.log
